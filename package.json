{
  "name": "bsc-local-fly-agent",
  "version": "4.0.0",
  "private": true,
  "productName": "FLAP Fly Agent",
  "description": "BNB Chain local fly-brain agent",
  "author": "FLAP Fly Agent",
  "main": "desktop/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.mjs",
    "desktop": "electron .",
    "desktop:package:win": "electron-builder --dir --win --x64",
    "desktop:make:win": "node scripts/make-windows-desktop.mjs",
    "release:build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "release:build:win:unsigned": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1 -Unsigned",
    "brain:setup": "node scripts/setup-full-brain.mjs",
    "brain:verify": "node scripts/run-full-brain.mjs verify",
    "brain:self-test": "node scripts/run-full-brain.mjs self-test",
    "cartridge:v3:build-check": "node scripts/build-fly-cartridge-v3.mjs",
    "cartridge:v3:direct-build-check": "node scripts/build-fly-cartridge-v3-direct.mjs",
    "cartridge:v3:image-build-check": "node scripts/build-fly-cartridge-v3-image.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "three": "^0.186.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "solc": "0.8.37"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
