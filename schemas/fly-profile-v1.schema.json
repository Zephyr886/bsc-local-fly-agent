{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flap.ai/schemas/fly-profile-v1.schema.json",
  "title": "FLAP Fly Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "flap.ai/v1" },
    "kind": { "const": "FlyProfile" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flyId", "revision", "name", "description", "tags", "createdAt", "updatedAt", "profileHash"],
      "properties": {
        "flyId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\s].*[^\\s]$|^[^\\s]$" }
        },
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" },
        "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" },
        "profileHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "universe", "perception", "learning", "reward", "strategy", "risk", "runtime"],
      "properties": {
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brainModel", "strategyEngine", "profileSchemaVersion"],
          "properties": {
            "brainModel": { "const": "malecns-v1", "default": "malecns-v1" },
            "strategyEngine": { "const": "hybrid-v2-profiled", "default": "hybrid-v2-profiled" },
            "profileSchemaVersion": { "const": 1, "default": 1 }
          }
        },
        "universe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chainId", "tokenBinding", "tokenAddress", "quotePreference"],
          "properties": {
            "chainId": { "const": 56, "default": 56 },
            "tokenBinding": { "enum": ["device-selected", "fixed"], "default": "device-selected" },
            "tokenAddress": {
              "default": null,
              "anyOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$" }
              ]
            },
            "quotePreference": { "const": "USDT", "default": "USDT" }
          },
          "allOf": [
            {
              "if": { "properties": { "tokenBinding": { "const": "fixed" } }, "required": ["tokenBinding"] },
              "then": { "properties": { "tokenAddress": { "type": "string", "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$" } } },
              "else": { "properties": { "tokenAddress": { "type": "null" } } }
            }
          ]
        },
        "perception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marketRefreshMs", "neuralDecisionIntervalSeconds", "historyCandles", "minimumHealthySamples", "marketMaxAgeSeconds", "flowMaxAgeSeconds"],
          "properties": {
            "marketRefreshMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 1000 },
            "neuralDecisionIntervalSeconds": { "type": "integer", "minimum": 10, "maximum": 3600, "default": 10 },
            "historyCandles": { "type": "integer", "minimum": 36, "maximum": 360, "default": 36 },
            "minimumHealthySamples": { "type": "integer", "minimum": 60, "maximum": 600, "default": 60 },
            "marketMaxAgeSeconds": { "type": "integer", "minimum": 5, "maximum": 60, "default": 15 },
            "flowMaxAgeSeconds": { "type": "integer", "minimum": 5, "maximum": 120, "default": 20 }
          }
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "neuralMs", "decoderThresholdHz", "checkpointEverySeconds"],
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "neuralMs": { "type": "number", "minimum": 100, "maximum": 2000, "multipleOf": 0.1, "default": 500 },
            "decoderThresholdHz": { "type": "number", "minimum": 0.1, "maximum": 50, "default": 2 },
            "checkpointEverySeconds": { "type": "integer", "minimum": 30, "maximum": 3600, "default": 60 }
          }
        },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "required": ["settlementHorizonsSeconds", "primaryHorizonSeconds", "returnScale", "followWeight", "positionWeight", "favorableWeight", "drawdownWeight", "pulseDeadband", "minimumPulseStrength"],
          "properties": {
            "settlementHorizonsSeconds": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "integer", "minimum": 300, "maximum": 86400 }, "default": [300, 900, 3600] },
            "primaryHorizonSeconds": { "type": "integer", "minimum": 300, "maximum": 86400, "default": 3600 },
            "returnScale": { "type": "number", "minimum": 0.001, "maximum": 1, "default": 0.05 },
            "followWeight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.65 },
            "positionWeight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
            "favorableWeight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
            "drawdownWeight": { "type": "number", "minimum": -1, "maximum": 0, "default": -0.05 },
            "pulseDeadband": { "type": "number", "minimum": 0, "maximum": 0.5, "default": 0 },
            "minimumPulseStrength": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 }
          }
        },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantThreshold", "positionBuyCeiling", "positionBurnFloor", "buyMaxReturn60s", "buyMaxReturn300s", "buyMaxDistanceFromLow300s", "burnMinReturn60s", "burnMinReboundFromLow300s", "frequencyActiveThreshold", "activeWindowSeconds", "activeMinActions", "activeMaxActions", "quietWindowSeconds", "quietMinActions", "quietMaxActions", "twapIntervalSeconds", "buyPercent", "burnPercent"],
          "properties": {
            "quantThreshold": { "type": "number", "minimum": 0.5, "maximum": 0.95, "default": 0.62 },
            "positionBuyCeiling": { "type": "number", "minimum": 0.05, "maximum": 0.95, "default": 0.55 },
            "positionBurnFloor": { "type": "number", "minimum": 0.05, "maximum": 0.95, "default": 0.55 },
            "buyMaxReturn60s": { "type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0 },
            "buyMaxReturn300s": { "type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0 },
            "buyMaxDistanceFromLow300s": { "type": "number", "minimum": 0, "maximum": 0.5, "default": 0.02 },
            "burnMinReturn60s": { "type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0.02 },
            "burnMinReboundFromLow300s": { "type": "number", "minimum": 0, "maximum": 0.5, "default": 0.02 },
            "frequencyActiveThreshold": { "type": "number", "minimum": 0.05, "maximum": 0.95, "default": 0.5 },
            "activeWindowSeconds": { "type": "integer", "minimum": 60, "maximum": 86400, "default": 300 },
            "activeMinActions": { "type": "integer", "minimum": 0, "maximum": 100, "default": 1 },
            "activeMaxActions": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
            "quietWindowSeconds": { "type": "integer", "minimum": 60, "maximum": 86400, "default": 3600 },
            "quietMinActions": { "type": "integer", "minimum": 0, "maximum": 100, "default": 1 },
            "quietMaxActions": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
            "twapIntervalSeconds": { "type": "integer", "minimum": 60, "maximum": 86400, "default": 300 },
            "buyPercent": { "type": "number", "minimum": 0, "maximum": 100, "default": 2 },
            "burnPercent": { "type": "number", "minimum": 0, "maximum": 100, "default": 1 }
          }
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveTradingEnabled", "capitalBudgetPercent", "maxPoolParticipationPercent", "maxBuyBnb", "slippagePercent", "dailyActionLimit", "minimumActionIntervalSeconds"],
          "properties": {
            "liveTradingEnabled": { "type": "boolean", "default": false },
            "capitalBudgetPercent": { "type": "number", "minimum": 0.1, "maximum": 25, "default": 10 },
            "maxPoolParticipationPercent": { "type": "number", "minimum": 0.01, "maximum": 2, "default": 0.5 },
            "maxBuyBnb": { "type": "string", "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$", "default": "0.2" },
            "slippagePercent": { "type": "number", "minimum": 0.1, "maximum": 15, "default": 0.5 },
            "dailyActionLimit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 24 },
            "minimumActionIntervalSeconds": { "type": "integer", "minimum": 60, "maximum": 86400, "default": 60 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["autoSave", "retainDecisionCount", "retainOutcomeCount", "retainFeedbackCount"],
          "properties": {
            "autoSave": { "const": true, "default": true },
            "retainDecisionCount": { "type": "integer", "minimum": 100, "maximum": 5000, "default": 500 },
            "retainOutcomeCount": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 1000 },
            "retainFeedbackCount": { "type": "integer", "minimum": 10, "maximum": 1000, "default": 100 }
          }
        }
      }
    }
  }
}
